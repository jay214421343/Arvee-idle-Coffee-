# Dedicated ARVEE Idle Discord application (do not use the main ARVEE bot token).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Recommended during testing; omitting it registers commands globally.
DISCORD_GUILD_ID=
# Dedicated PostgreSQL database, role and port. NEVER use ARVEE HUB_DATABASE_URL.
DATABASE_URL=postgresql://arvee_idle_app:CHANGE_ME@127.0.0.1:5432/arvee_idle
