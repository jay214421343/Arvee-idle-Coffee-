# Copy these keys into Idle's existing private .env. Do not replace DATABASE_URL
# or Discord credentials. Keep Idle on its existing dedicated PostgreSQL database.
IDLE_WEB_PORT=3092
IDLE_SERVICE_KEY=replace-with-32-or-more-random-characters
ARVEE_ECOSYSTEM_URL=http://127.0.0.1:3081
ARVEE_ECOSYSTEM_KEY=replace-with-a-different-32-or-more-random-secret
